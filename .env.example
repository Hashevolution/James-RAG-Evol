# ═══════════════════════════════════════════════════════════════
#  PROJECT JAMES — Environment Variables (Example)
#  
#  이 파일을 .env로 복사한 후 실제 값으로 채워주세요.
#  
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ── API 인증 키 (필수) ──────────────────────────────────────────
# 외부 클라이언트 식별용. 임의 문자열 가능.
JAMES_API_KEY=your-api-key-here

# ── JWT 시크릿 (필수, 절대 외부 노출 금지) ─────────────────────
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 운영 환경에서는 반드시 32자 이상 랜덤 문자열 사용
JAMES_JWT_SECRET=your-jwt-secret-here-min-32-chars

# ── Tavily 웹 검색 (선택) ──────────────────────────────────────
# 무료 키 발급: https://tavily.com (1,000 req/month)
# 미설정 시 DuckDuckGo로 자동 fallback
TAVILY_API_KEY=tvly-your-tavily-key-here

# ── 보호 파일 목록 (선택) ──────────────────────────────────────
# Tool 접근/수정 차단할 파일들 (쉼표 구분)
JAMES_PROTECTED_FILES=core/security_layer.py,core/auth.py,config.py

# ── LLM 프롬프트 길이 캡 (선택) ────────────────────────────────
# Gemma 클라이언트는 모든 프롬프트를 이 글자 수로 잘라냅니다. 코드
# 기본값은 2026-07-01부터 16000자(= 아래 synth 컨텍스트 8000 + 페르소나/
# 메모리/지시문 여유)로 이 파일과 동일합니다 — 과거 기본 4000자는 synth
# 프롬프트 7760 → 4000 절단(증거 절반 + 지시문 유실) 사례를 만들었던
# 이중 절단 결함이라 상향됐습니다. 더 크게/작게 조정 가능.
JAMES_GEMMA_MAX_PROMPT_CHARS=16000

# ── Ollama keep-alive (선택, 기본 30m) ─────────────────────────
# Ollama 서버 기본값은 유휴 ~5분 후 모델 언로드 → 다음 질문이 cold
# reload(12B+ 모델에서 수십 초)를 물게 됩니다. JAMES 는 기본 30m 을
# 요청에 실어 세션 동안 모델을 상주시킵니다. "0"/"off" 로 끄면 필드
# 자체를 보내지 않아 Ollama 서버 기본값이 적용됩니다.
# JAMES_OLLAMA_KEEP_ALIVE=30m

# synth 단계 검색 컨텍스트 글자 수 상한 (기본 8000). 위 프롬프트 캡보다
# 작아야 의미 있음.
# JAMES_SYNTH_CONTEXT_CHARS=8000

# ── Tesseract OCR 경로 (Windows만 해당) ───────────────────────
# 기본 경로와 다르면 명시
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Poppler 경로 (Windows만 해당, PDF 처리용) ─────────────────
# POPPLER_PATH=C:\Program Files\poppler\Library\bin
